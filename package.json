{
  "name": "brush-gpu",
  "version": "3.0.0",
  "description": "Pure-WebGPU fork of p5.brush (Alejandro Campos Uribe, MIT): custom brushes, natural fill effects and intuitive hatching, with GPU-resident geometry. Standalone build only \u2014 no p5.js dependency.",
  "main": "dist/brush.js",
  "module": "dist/brush.esm.js",
  "browser": "dist/brush.js",
  "exports": {
    "./standalone": {
      "import": "./dist/brush.esm.js",
      "require": "./dist/brush.js"
    }
  },
  "scripts": {
    "build": "rollup --config",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node test/e2e/smoke.mjs",
    "test:goldens": "node scripts/diff-parity.mjs --webgpu --goldens /test/goldens/tiles --regime character --tolerance 3.0",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lklyne/brush-gpu.git"
  },
  "keywords": [
    "brush",
    "brushes",
    "watercolor",
    "flowfield",
    "webgpu",
    "wgsl",
    "generative"
  ],
  "author": "Alejandro Campos Uribe",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lklyne/brush-gpu/issues"
  },
  "homepage": "https://github.com/lklyne/brush-gpu#readme",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "p5.brush": "2.2.2",
    "playwright-chromium": "^1.58.2",
    "rollup": "^4.9.4",
    "rollup-plugin-cleanup": "^3.2.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3"
  },
  "contributors": [
    "Lyle Klyne"
  ]
}
